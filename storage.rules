rules_version = '2';

// Food images are public (read) but only the signed-in admin can upload,
// and only images up to 5 MB are accepted.
service firebase.storage {
  match /b/{bucket}/o {
    match /menu-images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
