# ---------------------------------------------------------------
# Sarthak Cafe — Firebase configuration (client side)
# Firebase Console > Project Settings > Your apps > SDK setup
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------
# Seed script only (scripts/seed.mjs) — not used by the web app
# Path to the firebase-admin service account JSON key file.
# ---------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json

# Optional: the seed script will create this admin login
# (Firebase Console > Authentication > Users will also work)
ADMIN_EMAIL=admin@sarthakcafe.in
ADMIN_PASSWORD=ChangeMe@123
